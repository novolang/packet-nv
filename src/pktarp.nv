// pktarp.nv — the Address Resolution Protocol of RFC 826, as spans.
//
// ARP HAS NO FIXED LAYOUT
//
// Every other header this package reads has fields at fixed offsets.
// An ARP packet does not: after eight fixed bytes it carries four
// addresses whose sizes are given by two of those bytes.  The hardware
// address length and the protocol address length are read first, and
// every offset after them is computed.  RFC 826 was written that way on
// purpose — it resolves any protocol address over any hardware address
// — and the consequence is that a parser with the Ethernet-over-IPv4
// offsets baked in is a parser that reads the wrong bytes the first
// time it meets anything else.
//
// So `sender_protocol_span` takes the buffer, because it cannot know
// where the field is without reading two other fields first, and
// `sender_ipv4` refuses a packet whose protocol length is not four
// rather than reading four bytes of an address that is sixteen bytes
// long.
//
// WHAT IS NOT HERE
//
// There is no ARP cache.  A cache is state with a lifetime, an
// eviction rule and a conflict policy, and all three belong to the
// program that owns the interface.  This module reads and writes the
// packets.
//
// THE ANNOUNCEMENT CASE
//
// A packet whose sender and target protocol addresses are the same is
// a gratuitous ARP: a host telling the segment which hardware address
// now answers for an address.  It is how a machine announces itself
// after booting, how a failover pair moves a service address, and how
// an attacker takes over a gateway.  The three are the same packet, so
// `is_gratuitous` reports the shape and says nothing about the intent.

// An ARP packet, as a span over the caller's buffer.
//
// The fields after the first eight bytes are at offsets computed from
// the two length bytes, so every accessor for them takes the buffer.
//
// ```novo
// use std.bytes
// use pktspan
// use pktarp
//
// fn main() [io]
//     let buf = bytes.zeros(28)
//     match pktarp.parse(buf, pktspan.whole(buf))
//         Ok(a)  => println("${a.span.len}")
//         Err(e) => println(e.message())
// ```
pub struct PktArp
    // The whole packet, from the hardware type to the last byte of the
    // target protocol address.  Its length is eight plus twice the
    // hardware address length plus twice the protocol address length.
    span: PktSpan

// The operation an ARP packet requests.
//
// ```novo
// use pktarp
//
// fn main() [io]
//     println("${pktarp.operation_code(PktArpRequest)}")
// ```
pub enum PktArpOp
    // 1.  A request: "who has this protocol address".  Sent to the
    // broadcast hardware address, with the target hardware address
    // field set to zeroes, because it is the thing being asked for.
    PktArpRequest
    // 2.  A reply: "this hardware address has it".  Sent to the
    // requester, and a host that believes any reply it sees rather
    // than one it asked for is a host anybody on the segment can
    // redirect.
    PktArpReply
    // Any other operation, carrying the number.  3 and 4 are reverse
    // ARP, 8 and 9 are inverse ARP; both are the same packet shape
    // with a different question.
    PktArpOther(code: Int)

// Read an ARP packet out of a span.
//
// Reads the two length bytes and requires eight plus twice each of
// them; `PktTruncated` when the span is shorter.  Checks nothing about
// which address families are named, because RFC 826 permits any pair —
// `sender_ipv4` is where the Ethernet-over-IPv4 assumption is made and
// refused.
//
// ```novo
// use std.bytes
// use pktspan
// use pktarp
//
// fn main() [io]
//     let buf = bytes.zeros(28)
//     match pktarp.parse(buf, pktspan.whole(buf))
//         Ok(a)  => println("${a.span.off}")
//         Err(e) => println(e.message())
// ```
pub fn parse(buf: Bytes, at: PktSpan) -> Result<PktArp, PktError>
    todo("packet-nv.pktarp.parse")

// The hardware type: 1 for Ethernet (RFC 826 and the IANA hardware
// types registry).
//
// ```novo
// use std.bytes
// use pktspan
// use pktarp
//
// fn main() [io]
//     let buf = bytes.zeros(28)
//     match pktarp.parse(buf, pktspan.whole(buf))
//         Ok(a)  =>
//             match pktarp.hardware_type(buf, a)
//                 Ok(t)  => println("${t}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn hardware_type(buf: Bytes, a: PktArp) -> Result<Int, PktError>
    todo("packet-nv.pktarp.hardware_type")

// The protocol type, using the ethertype numbering: 0x0800 for IPv4.
//
// There is no ARP for IPv6.  IPv6 resolves addresses with Neighbour
// Discovery, which is ICMPv6 and is read by `pkticmp`, so a packet
// here naming 0x86DD is malformed rather than interesting.
//
// ```novo
// use std.bytes
// use pktspan
// use pktarp
//
// fn main() [io]
//     let buf = bytes.zeros(28)
//     match pktarp.parse(buf, pktspan.whole(buf))
//         Ok(a)  =>
//             match pktarp.protocol_type(buf, a)
//                 Ok(t)  => println("${t}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn protocol_type(buf: Bytes, a: PktArp) -> Result<Int, PktError>
    todo("packet-nv.pktarp.protocol_type")

// The hardware address length in bytes: 6 for Ethernet.
//
// Every offset past the first eight bytes depends on this.
//
// ```novo
// use std.bytes
// use pktspan
// use pktarp
//
// fn main() [io]
//     let buf = bytes.zeros(28)
//     match pktarp.parse(buf, pktspan.whole(buf))
//         Ok(a)  =>
//             match pktarp.hardware_length(buf, a)
//                 Ok(n)  => println("${n}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn hardware_length(buf: Bytes, a: PktArp) -> Result<Int, PktError>
    todo("packet-nv.pktarp.hardware_length")

// The protocol address length in bytes: 4 for IPv4.
//
// ```novo
// use std.bytes
// use pktspan
// use pktarp
//
// fn main() [io]
//     let buf = bytes.zeros(28)
//     match pktarp.parse(buf, pktspan.whole(buf))
//         Ok(a)  =>
//             match pktarp.protocol_length(buf, a)
//                 Ok(n)  => println("${n}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn protocol_length(buf: Bytes, a: PktArp) -> Result<Int, PktError>
    todo("packet-nv.pktarp.protocol_length")

// The operation.
//
// ```novo
// use std.bytes
// use pktspan
// use pktarp
//
// fn main() [io]
//     let buf = bytes.zeros(28)
//     match pktarp.parse(buf, pktspan.whole(buf))
//         Ok(a)  =>
//             match pktarp.operation(buf, a)
//                 Ok(o)  => println(pktarp.operation_name(o))
