// pktudp.nv — the User Datagram Protocol of RFC 768, which is eight
// bytes and two rules people get wrong.
//
// THE LENGTH FIELD INCLUDES THE HEADER
//
// The length is the datagram's, header included, so an eight-byte
// length means an empty payload and a length below eight is malformed.
// A parser that took the length as the payload length reads eight bytes
// too many, which on a padded Ethernet frame is eight bytes of padding
// and on a full frame is the start of whatever came next in the buffer.
//
// The field is also the second place the datagram's size is written:
// the IP total length says it too, and the two can disagree.  When they
// do, the IP header is the one to believe, because that is what the
// routers used.  `parse` narrows to the UDP length and refuses one that
// exceeds the span, so a disagreement is a refusal rather than a silent
// choice.
//
// A ZERO CHECKSUM IS NOT A WRONG CHECKSUM
//
// RFC 768 makes the checksum optional over IPv4: a sender that did not
// compute one writes zero, and a receiver must not check.  A great deal
// of real traffic does this — tunnelling protocols, embedded telemetry,
// some resolvers on a local segment — so a tool that reported a zero as
// corruption would report a working network as broken.
//
// `PktChecksumAbsent` is that case and it is neither valid nor wrong.
// Over IPv6 the rule reverses: RFC 8200 section 8.1 requires the
// checksum, so a zero there is wrong, and `verify_checksum` decides
// which rule applies from the pseudo-header it is given rather than
// from a flag the caller might forget.
//
// AND A COMPUTED ZERO IS WRITTEN AS 0xFFFF
//
// If the sum comes out zero, a sender writes 0xFFFF instead, because
// zero in the field means "no checksum".  The two are the same number
// in one's-complement arithmetic, so it changes nothing about the check
// and everything about what the field means.
// `pktsum.udp_transmit_value` is the rule and `build` applies it.

// A UDP header, as two spans into the caller's buffer.
//
// ```novo
// use std.bytes
// use pktspan
// use pktudp
//
// fn main() [io]
//     let buf = bytes.zeros(20)
//     match pktudp.parse(buf, pktspan.whole(buf))
//         Ok(u)  => println("${u.payload.len}")
//         Err(e) => println(e.message())
// ```
pub struct PktUdp
    // The eight-byte header.  Always eight bytes: UDP has no options.
    header: PktSpan
    // The payload, narrowed to the length field less eight.
    payload: PktSpan

// Read a UDP header out of a span.
//
// Requires eight bytes, refuses a length field below 8 with
// `PktBadLength`, and refuses a length longer than the span with
// `PktTruncated`.  The payload is narrowed to the length less eight, so
// Ethernet padding behind a short datagram is not part of it.
//
// ```novo
// use std.bytes
// use pktspan
// use pktudp
//
// fn main() [io]
//     let buf = bytes.zeros(20)
//     match pktudp.parse(buf, pktspan.whole(buf))
//         Ok(u)  => println("${u.header.len}")
//         Err(e) => println(e.message())
// ```
pub fn parse(buf: Bytes, at: PktSpan) -> Result<PktUdp, PktError>
    todo("packet-nv.pktudp.parse")

// The source port.
//
// Zero is legal and means the sender wants no reply — RFC 768's own
// wording is that it is optional and a zero is used when no reply is
// expected.
//
// ```novo
// use std.bytes
// use pktspan
// use pktudp
//
// fn main() [io]
//     let buf = bytes.zeros(20)
//     match pktudp.parse(buf, pktspan.whole(buf))
//         Ok(u)  =>
//             match pktudp.source_port(buf, u)
//                 Ok(p)  => println("${p}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn source_port(buf: Bytes, u: PktUdp) -> Result<Int, PktError>
    todo("packet-nv.pktudp.source_port")

// The destination port.
//
// ```novo
// use std.bytes
// use pktspan
// use pktudp
//
// fn main() [io]
//     let buf = bytes.zeros(20)
//     match pktudp.parse(buf, pktspan.whole(buf))
//         Ok(u)  =>
//             match pktudp.destination_port(buf, u)
//                 Ok(p)  => println("${p}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
