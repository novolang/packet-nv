// The length field: the header AND the payload, in bytes.
//
// Eight means an empty payload.  Not the payload length, which is this
// less eight, and `payload` is what answers that without the
// subtraction.
//
// ```novo
// use std.bytes
// use pktspan
// use pktudp
//
// fn main() [io]
//     let buf = bytes.zeros(20)
//     match pktudp.parse(buf, pktspan.whole(buf))
//         Ok(u)  =>
//             match pktudp.length(buf, u)
//                 Ok(n)  => println("${n}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn length(buf: Bytes, u: PktUdp) -> Result<Int, PktError>
    todo("packet-nv.pktudp.length")

// The checksum as the header carries it.
//
// Zero means the sender computed none, over IPv4.  The value, not a
// verdict; `verify_checksum` is the verdict.
//
// ```novo
// use std.bytes
// use pktspan
// use pktudp
//
// fn main() [io]
//     let buf = bytes.zeros(20)
//     match pktudp.parse(buf, pktspan.whole(buf))
//         Ok(u)  =>
//             match pktudp.checksum(buf, u)
//                 Ok(c)  => println("${c}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn checksum(buf: Bytes, u: PktUdp) -> Result<Int, PktError>
    todo("packet-nv.pktudp.checksum")

// The payload, narrowed to the length field less eight.
//
// ```novo
// use std.bytes
// use pktspan
// use pktudp
//
// fn main() [io]
//     let buf = bytes.zeros(20)
//     match pktudp.parse(buf, pktspan.whole(buf))
//         Ok(u)  => println("${pktudp.payload(u).len}")
//         Err(e) => println(e.message())
// ```
pub fn payload(u: PktUdp) -> PktSpan
    todo("packet-nv.pktudp.payload")

// Verify the checksum over the pseudo-header, the header and the
// payload.
//
// THE FOUR ANSWERS, and which one comes back depends on the version the
// pseudo-header names:
//
//   * `PktChecksumAbsent` for a carried zero over IPv4, where RFC 768
//     makes the checksum optional;
//   * `PktChecksumWrong` for a carried zero over IPv6, where RFC 8200
//     section 8.1 requires it;
//   * `PktChecksumUnverifiable` when the payload is not all present,
//     which is every truncated capture and every locally captured
//     offloaded send;
//   * `PktChecksumValid` when the sums agree.
//
// The version comes from the pseudo-header rather than from a flag,
// because the caller that built the pseudo-header had an IP header in
// front of it and a flag is something to get wrong later.
//
// ```novo
// use std.bytes
// use ip
// use pktspan
// use pktudp
// use pktsum
// use pktproto
//
// fn main() [io]
//     let buf = bytes.zeros(20)
//     let p = pktsum.pseudo_ipv4(ip.ipv4_zero(), ip.ipv4_zero(), PktProtoUdp, 20)
//     match pktudp.parse(buf, pktspan.whole(buf))
//         Ok(u)  =>
//             match pktudp.verify_checksum(buf, u, p)
//                 Ok(c)  => println(pktsum.checksum_reason(c))
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn verify_checksum(buf: Bytes, u: PktUdp, p: PktPseudo) -> Result<PktChecksum, PktError>
    todo("packet-nv.pktudp.verify_checksum")

// Build a UDP datagram with a checksum.
//
// Writes the length as eight plus the payload, computes the checksum
// over the pseudo-header, and writes 0xFFFF when the sum comes out
// zero.  `PktBadLength` for a payload longer than 65527 bytes, which is
// the largest the sixteen-bit length field can describe beside the
// header.
//
// ```novo
// use std.bytes
// use ip
// use pktudp
// use pktsum
// use pktproto
//
// fn main() [io]
//     let p = pktsum.pseudo_ipv4(ip.ipv4(10, 0, 0, 1), ip.ipv4(10, 0, 0, 2),
//                                PktProtoUdp, 12)
//     match pktudp.build(5353, 5353, bytes.zeros(4), p)
//         Ok(d)  => println("${bytes.len(d)}")
//         Err(e) => println(e.message())
// ```
pub fn build(source_port: Int, destination_port: Int, payload: Bytes,
             p: PktPseudo) -> Result<Bytes, PktError>
    todo("packet-nv.pktudp.build")

// Build a UDP datagram with a zero checksum, for IPv4 only.
//
// Named so a reviewer can see it.  RFC 768 permits it over IPv4 and RFC
// 8200 section 8.1 forbids it over IPv6, with the tunnelling case of
// RFC 6935 the one exception, so the name says which version it is for
// and the function takes no pseudo-header at all — there is nothing for
// it to checksum.
//
// A datagram built this way has no end-to-end integrity check of any
// kind, because IPv4's own checksum covers the header and not the
// payload.  It is the right choice when the payload carries its own
// integrity check and the wrong one otherwise.
//
// ```novo
// use std.bytes
// use pktudp
//
// fn main() [io]
//     match pktudp.build_ipv4_without_checksum(5353, 5353, bytes.zeros(4))
//         Ok(d)  => println("${bytes.len(d)}")
//         Err(e) => println(e.message())
// ```
pub fn build_ipv4_without_checksum(source_port: Int, destination_port: Int,
                                   payload: Bytes) -> Result<Bytes, PktError>
    todo("packet-nv.pktudp.build_ipv4_without_checksum")
